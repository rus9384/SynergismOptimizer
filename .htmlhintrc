{
  "alt-require": true,
  "attr-lowercase": true,
  "attr-no-duplication": true,
  "attr-value-no-duplication": true,
  "attr-value-double-quotes": true,
  "attr-whitespace": true,
  "doctype-first": true,
  "doctype-html5": true,
  "head-script-disabled": "allow-non-blocking",
  "html-lang-require": true,
  "id-class-ad-disabled": true,
  "id-unique": true,
  "link-rel-canonical-require": true,
  "main-require": true,
  "meta-charset-require": true,
  "meta-description-require": false,
  "meta-viewport-require": true,
  "space-tab-mixed-disabled": "space2",
  "spec-char-escape": true,
  "src-not-empty": true,
  "tag-no-obsolete": true,
  "tag-pair": true,
  "tag-self-close": true,
  "tagname-lowercase": true,
  "tagname-specialchars": true,
  "title-require": true
}